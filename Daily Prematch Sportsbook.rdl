    <DataSet Name="InterfaceRF">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH 
c AS 
  (
  SELECT DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM bet.FactCustomerSegment fcs
  join bet.DimRiskFactor r on r.DimRiskFactorID = fcs.DimRiskFactorID_Live
  GROUP BY fcs.DimCustomerID

  ),
d AS (
  SELECT fcs.DimCustomerID, 
  r.riskFactor
  FROM bet.FactCustomerSegment fcs
  JOIN bet.DimRiskFactor r ON r.DimRiskFactorID = fcs.DimRiskFactorID_Live
  JOIN c ON c.DimCustomerID = fcs.DimCustomerID AND  c.Fresh = fcs.ETLts
  
  )
,
a AS (
SELECT 
di.etlek AS Interface,
SUM (fs.stake) as Turnover,
SUM (fs.evaluatedProfit+fs.evaluatedTax) AS Winnings,
COUNT(fs.ETLek) AS SlipCount,
COUNT(DISTINCT fs.DimCustomerID) AS PlayerCount


FROM bet.FactSlip fs WITH (NOLOCK)
      left join d on d.DimCustomerID = fs.DimCustomerID
	  JOIN core.DimInterface di WITH (NOLOCK) ON di.DimInterfaceID = fs.DimInterfaceID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND d.riskFactor &lt;= 1
	   AND fs.DimCustomerID != 0
 
GROUP BY  di.ETLek
)
SELECT a.Interface,
a.Turnover, a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/a.Turnover AS Margin,  a.SlipCount, a.PlayerCount
FROM a 
ORDER BY Turnover desc</CommandText>
      </Query>
      <Fields>
        <Field Name="Interface">
          <DataField>Interface</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PlayerCount">
          <DataField>PlayerCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TicketsRF">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH 
c AS 
  (
  SELECT DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM bet.FactCustomerSegment fcs
  GROUP BY fcs.DimCustomerID

  ),
d AS (
  SELECT fcs.DimCustomerID, 
  r.riskFactor
  FROM bet.FactCustomerSegment fcs
  JOIN bet.DimRiskFactor r ON r.DimRiskFactorID = fcs.DimRiskFactorID_Prematch
  JOIN c ON c.DimCustomerID = fcs.DimCustomerID AND  c.Fresh = fcs.ETLts
  
  )
,
a AS (
SELECT 
d.riskFactor as RiskFactor,
SUM (fs.stake) as Turnover,
SUM (fs.evaluatedProfit+fs.evaluatedTax) AS Winnings,
COUNT(fs.ETLek) AS SlipCount,
COUNT(DISTINCT fs.DimCustomerID) AS PlayerCount


FROM bet.FactSlip fs WITH (NOLOCK)
      left join d on d.DimCustomerID = fs.DimCustomerID
	  JOIN core.DimInterface di WITH (NOLOCK) ON di.DimInterfaceID = fs.DimInterfaceID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND d.riskFactor &lt;= 1
	   AND fs.DimCustomerID != 0
 
GROUP BY  d.riskFactor
)


SELECT a.RiskFactor,
a.Turnover, a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/a.Turnover AS Margin,  a.SlipCount, a.PlayerCount
FROM a 
ORDER BY RiskFactor</CommandText>
      </Query>
      <Fields>
        <Field Name="RiskFactor">
          <DataField>RiskFactor</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PlayerCount">
          <DataField>PlayerCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SportsRF">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH 
c AS 
  (
  SELECT DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM bet.FactCustomerSegment fcs
  GROUP BY fcs.DimCustomerID

  ),
d AS (
  SELECT fcs.DimCustomerID, 
  r.riskFactor
  FROM bet.FactCustomerSegment fcs
  JOIN bet.DimRiskFactor r ON r.DimRiskFactorID = fcs.DimRiskFactorID_Prematch
  JOIN c ON c.DimCustomerID = fcs.DimCustomerID AND  c.Fresh = fcs.ETLts
  
  )
,
a AS (
SELECT 
dpl.nameLocal AS Sport,
SUM (fsb.avgStake) as Turnover,
SUM (fsb.wtEvaluatedProfit + fsb.wtEvaluatedTax) AS Winnings,
COUNT(DISTINCT fs.ETLek) AS SlipCount


FROM bet.FactSlip fs WITH (NOLOCK)
      left join d on d.DimCustomerID = fs.DimCustomerID
	  JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
	  JOIN core.DimProductLine dpl WITH (NOLOCK) ON fsb.DimProductLineID = dpl.DimProductLineID
	  JOIN core.DimInterface di WITH (NOLOCK) ON di.DimInterfaceID = fs.DimInterfaceID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND d.riskFactor &lt;= 1
	   AND fs.DimCustomerID != 0
 
GROUP BY  dpl.nameLocal
)

SELECT 
    a.Sport,
    a.Turnover, 
    a.Turnover - a.Winnings AS GGR, 
    CASE 
        WHEN a.Turnover = 0 THEN 0 
        ELSE (a.Turnover - a.Winnings) / a.Turnover 
    END AS Margin,  
    a.SlipCount
FROM a 
ORDER BY a.Turnover DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="Sport">
          <DataField>Sport</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MatchesRF">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);


WITH 
c AS 
  (
  SELECT DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM bet.FactCustomerSegment fcs
  GROUP BY fcs.DimCustomerID

  ),
d AS (
  SELECT fcs.DimCustomerID, r.riskFactor
  FROM bet.FactCustomerSegment fcs
  JOIN bet.DimRiskFactor r ON r.DimRiskFactorID = fcs.DimRiskFactorID_Prematch
  JOIN c ON c.DimCustomerID = fcs.DimCustomerID AND  c.Fresh = fcs.ETLts
  
  )
,
a AS (
SELECT 
dpl.nameLocal as Sport,
de.nameLocal AS Event,
f.starts_at as Date,
SUM (fsb.avgStake) as Turnover,
SUM (fsb.wtEvaluatedProfit+fsb.wtEvaluatedTax) AS Winnings,
COUNT(DISTINCT fs.ETLek) AS SlipCount,
COUNT(DISTINCT fs.DimCustomerID) AS PlayerCount

FROM bet.FactSlip fs WITH (NOLOCK)
      left join d on d.DimCustomerID = fs.DimCustomerID
	  JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
	  JOIN core.DimProductLine dpl WITH (NOLOCK) ON fsb.DimProductLineID = dpl.DimProductLineID
	  JOIN bet.DimEvent de WITH (NOLOCK) ON fsb.DimEventID = de.DimEventID
	  JOIN bet.SuperSport.sbk_offer.fixtures f on f.fid = 'f' + CAST(de.ETLek AS VARCHAR)
	  JOIN core.DimInterface di WITH (NOLOCK) ON di.DimInterfaceID = fs.DimInterfaceID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID
	  JOIN core.DimDate dd  WITH (NOLOCK) ON dd.DimDateID = de.DimDateID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND d.riskFactor &lt;= 1
	   AND fs.DimCustomerID != 0
 
GROUP BY  dpl.nameLocal, de.nameLocal, f.starts_at
)

SELECT top (15) a.Sport, a.Event,  a.Date,
a.SlipCount, a.Turnover, a.Turnover-a.Winnings as GGR
FROM a 
ORDER BY Turnover desc</CommandText>
      </Query>
      <Fields>
        <Field Name="Sport">
          <DataField>Sport</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Event">
          <DataField>Event</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date">
          <DataField>Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TotalPlayers">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);



SELECT
COUNT(DISTINCT fs.DimCustomerID) AS PlayerCount

FROM bet.FactSlip fs WITH (NOLOCK)
	  JOIN core.DimInterface di WITH (NOLOCK) ON di.DimInterfaceID = fs.DimInterfaceID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
       AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
       AND fs.containsLive = 0</CommandText>
      </Query>
      <Fields>
        <Field Name="PlayerCount">
          <DataField>PlayerCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TotalInterfaceRF">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH 
c AS 
  (
  SELECT DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM bet.FactCustomerSegment fcs
  GROUP BY fcs.DimCustomerID

  ),
d AS (
  SELECT fcs.DimCustomerID, r.riskFactor
  FROM bet.FactCustomerSegment fcs
  JOIN c ON c.DimCustomerID = fcs.DimCustomerID AND  c.Fresh = fcs.ETLts
  join bet.DimRiskFactor r on r.DimRiskFactorID = fcs.DimRiskFactorID_Prematch
  
  )


SELECT 

COUNT(DISTINCT fs.DimCustomerID) AS PlayerCount


FROM bet.FactSlip fs WITH (NOLOCK)
      left join d on d.DimCustomerID = fs.DimCustomerID
	  JOIN core.DimInterface di WITH (NOLOCK) ON di.DimInterfaceID = fs.DimInterfaceID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND fs.DimCustomerID != 0
	   AND d.riskFactor &lt; 1</CommandText>
      </Query>
      <Fields>
        <Field Name="PlayerCount">
          <DataField>PlayerCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="NewClients">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);



--casino
with a as (
select distinct fgs.DimCustomerID
 from cas.FactGameSpins fgs
),
--poker
d as (
select distinct fph.DimCustomerID
 from cas.FactPokerHands fph
),

--turniri
e as (
select distinct fpm.DimCustomerID_Player1
from cas.FactPokerPlayerMatchup fpm
),
f as (
select distinct fpm.DimCustomerID_Player2
from cas.FactPokerPlayerMatchup fpm
),
--loto virtuali
lv as (
select distinct fs.DimCustomerID
from bet.FactSlip fs
JOIN core.DimSubsidiary ds on ds.DimSubsidiaryID = fs.DimSubsidiaryID

WHERE  fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID in (6,7)
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
	   AND ds.ETLek &gt;0
)
,
--betting sports
b as (
select dc.DimCustomerID, dc.nickname, 
MIN (fs.DimDateID_Evaluated) as Min

from bet.FactSlip fs
join core.DimCustomer dc on fs.DimCustomerID = dc.DimCustomerID
JOIN core.DimSubsidiary ds on ds.DimSubsidiaryID = fs.DimSubsidiaryID

WHERE  fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0

group by dc.DimCustomerID, dc.nickname

having MIN (fs.DimDateID_Evaluated) between @Start and @End
),

--novi sports koji nemaju raniji histroy na pokeru, casinu, lotu, virtualima
g as (
select b.DimCustomerID as DimCustomerID
from b
left join a on b.DimCustomerID = a.DimCustomerID
left join d on b.DimCustomerID = d.DimCustomerID
left join lv on b.DimCustomerID = lv.DimCustomerID
left join e on b.DimCustomerID = e.DimCustomerID_Player1
left join f on b.DimCustomerID = f.DimCustomerID_Player2

where a.DimCustomerID is null and d.DimCustomerID is null and e.DimCustomerID_Player1 is null and f.DimCustomerID_Player2 is null and lv.DimCustomerID is null
),
--risk faktori
h AS 
  (
  SELECT g.DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM g
  JOIN bet.FactCustomerSegment fcs on fcs.DimCustomerID = g.DimCustomerID
  GROUP BY g.DimCustomerID
  ),
k AS (
  SELECT fcs.DimCustomerID,  fcs.DimRiskFactorID_Prematch, rs.riskFactor
  FROM bet.FactCustomerSegment fcs
  join bet.DimRiskFactor rs on rs.DimRiskFactorID = fcs.DimRiskFactorID_Prematch
  JOIN h ON h.DimCustomerID = fcs.DimCustomerID AND  h.Fresh = fcs.ETLts
  )
,
aa as (
SELECT  dc.nickname AS Nickname, fs.DimCustomerID, k.riskFactor,
SUM (fs.stake) as Turnover,
SUM (fs.evaluatedProfit+fs.evaluatedTax) as Winnings,
COUNT(fs.ETLek) AS SlipCount



FROM g
      left join k on k.DimCustomerID = g.DimCustomerID
      join bet.FactSlip fs WITH (NOLOCK) on g.DimCustomerID = fs.DimCustomerID
      join core.DimCustomer DC WITH (NOLOCK) ON fs.DimCustomerID = DC.DimCustomerID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated =@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
 
GROUP BY  dc.nickname, fs.DimCustomerID, k.riskFactor
)




SELECT top (15) aa.Nickname, aa.DimCustomerID,
ISNULL(CAST(aa.riskFactor AS varchar(50)), 'Unassigned') as riskFactor,
aa.Turnover, aa.SlipCount, aa.Turnover-aa.Winnings as GGR, CASE 
    WHEN aa.Turnover = 0 THEN 0 
    ELSE (aa.Turnover - aa.Winnings) / aa.Turnover 
END AS Margin
FROM aa ;</CommandText>
      </Query>
      <Fields>
        <Field Name="Nickname">
          <DataField>Nickname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DimCustomerID">
          <DataField>DimCustomerID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="riskfactor">
          <DataField>riskFactor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TotalNewClients">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

--casino
with a as (
select distinct fgs.DimCustomerID
 from cas.FactGameSpins fgs
),
--poker
d as (
select distinct fph.DimCustomerID
 from cas.FactPokerHands fph
),

--turniri
e as (
select distinct fpm.DimCustomerID_Player1
from cas.FactPokerPlayerMatchup fpm
),
f as (
select distinct fpm.DimCustomerID_Player2
from cas.FactPokerPlayerMatchup fpm
)
,
--betting sports
b as (
select dc.DimCustomerID, dc.nickname, 
MIN (fs.DimDateID_Evaluated) as Min

from bet.FactSlip fs
join core.DimCustomer dc on fs.DimCustomerID = dc.DimCustomerID
JOIN core.DimSubsidiary ds on ds.DimSubsidiaryID = fs.DimSubsidiaryID

WHERE  fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0

group by dc.DimCustomerID, dc.nickname

having MIN (fs.DimDateID_Evaluated) between @Start and @End
),
--loto virtuali
lv as (
select distinct fs.DimCustomerID
from bet.FactSlip fs
JOIN core.DimSubsidiary ds on ds.DimSubsidiaryID = fs.DimSubsidiaryID

WHERE  fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID in (6,7)
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
	   AND ds.ETLek &gt;0
),

--novi sports koji nemaju raniji histroy na pokeru, casinu
g as (
select b.DimCustomerID
from b
left join a on b.DimCustomerID = a.DimCustomerID
left join d on b.DimCustomerID = d.DimCustomerID
left join lv on b.DimCustomerID = lv.DimCustomerID
left join e on b.DimCustomerID = e.DimCustomerID_Player1
left join f on b.DimCustomerID = f.DimCustomerID_Player2

where a.DimCustomerID is null and d.DimCustomerID is null and e.DimCustomerID_Player1 is null and f.DimCustomerID_Player2 is null and lv.DimCustomerID is null
)

select count (distinct g.dimcustomerid)
from g</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TotalLiveMatches">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);




SELECT COUNT (DISTINCT de.DimEventID)


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
	  JOIN bet.DimEvent de WITH (NOLOCK) ON fsb.DimEventID = de.DimEventID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID


WHERE DimDateID_Evaluated =@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND fsb.DimProductTypeID = 1</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LiveSingleGGR">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);



WITH a AS (
SELECT 

SUM (fsb.avgStake) - SUM (fsb.wtEvaluatedProfit+fsb.wtEvaluatedTax) AS GGR,
SUM (CASE WHEN fs.countBets = 1 THEN fsb.avgStake ELSE 0 END) - SUM (CASE WHEN fs.countBets = 1 THEN fsb.wtEvaluatedProfit+fsb.wtEvaluatedTax ELSE 0 END) AS GGRSingle


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;= @Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
)

SELECT a.GGRSingle/a.GGR
FROM a</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LiveSingleTurnover">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);



WITH a AS (
SELECT 

SUM (fsb.avgStake)  AS Turnover,
SUM (CASE WHEN fs.countBets = 1 THEN fsb.avgStake ELSE 0 END) AS TurnoverSingle


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;= @Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
)

SELECT a.TurnoverSingle/a.Turnover
FROM a</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="BB">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH 
p as (
select dms.DimMarketSelectionID, dms.marketLocal,dp.DimProviderID, fsb.factslipbetid,
 case   when  (dms.DimMarketSelectionID not in (594722, 274401) and dms.marketLocal like '%super%' and dms.marketLocal not like '%superkup%') THEN 'Super Markets'
        when (dms.DimMarketSelectionID in (594722, 274401) and fsb.DimProviderID in (5,48)) then 'Betbuilder Sportcast'
        when (dms.DimMarketSelectionID in (594722, 274401) and fsb.DimProviderID =74) then 'Betbuilder Huddle Prematch'
        when (dms.DimMarketSelectionID in (594722, 274401) and fsb.DimProviderID =75) then 'Betbuilder Huddle Live'
        when (dms.marketLocal = 'SUPERBUILDER' and fsb.DimProviderID = 73) then 'Betbuilder Betradar Prematch'
        when (dms.marketLocal = 'BETBUILDER MARKET' and fsb.DimProviderID = 83) then 'Betbuilder Betradar Live'
end as Type

from bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
	  JOIN bet.DimMarketSelection dms with (nolock) on dms.DimMarketSelectionID = fsb.DimMarketSelectionID
      JOIN core.DimProvider dp ON fsb.DimProviderID = dp.DimProviderID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID


WHERE DimDateID_Evaluated &gt;= @Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
       and dp.descriptionLocal not like '%live%'

--order by type desc
)
,
a AS (
SELECT 
p.Type,
SUM (fsb.avgStake) as Turnover,
SUM (fsb.wtEvaluatedProfit+fsb.wtEvaluatedTax) as Winnings,
COUNT(distinct fs.ETLek) AS SlipCount


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
	  JOIN p on p.FactSlipBetID = fsb.FactSlipBetID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;= @Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
       and p.Type is not null
       

group by p.Type

)

SELECT a.Type, a.Turnover,a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/a.Turnover AS Margin, a.SlipCount
from a
order by GGR desc;</CommandText>
      </Query>
      <Fields>
        <Field Name="Type">
          <DataField>Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RankMS">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH a AS (
SELECT  TOP (10) 
--de.DimEventID,  
dpl.namelocal + ' - ' + de.nameLocal as Event,
de.nameLocal as Match   ,
f.starts_at as Date,
dpl.typeLocal as League,
SUM (fsb.avgStake) - SUM (fsb.wtEvaluatedProfit + fsb.wtEvaluatedTax) as EventGGR,
ROW_NUMBER() OVER (ORDER BY SUM (fsb.avgStake) - SUM (fsb.wtEvaluatedProfit + fsb.wtEvaluatedTax) DESC) AS Rank


FROM bet.FactSlip                               fs  WITH (NOLOCK)
      JOIN bet.FactSlipBet                      fsb WITH (NOLOCK) ON fs.ETLek = fsb.ETLek
	  JOIN bet.DimEvent                         de  WITH (NOLOCK) ON fsb.DimEventID = de.DimEventID
      JOIN bet.SuperSport.sbk_offer.fixtures    f                 ON f.fid = 'f' + CAST(de.ETLek AS VARCHAR)
      JOIN bet.DimMarketSelection               dms with (nolock) ON dms.DimMarketSelectionID = fsb.DimMarketSelectionID 
      JOIN core.DimProductLine                  dpl WITH (NOLOCK) ON fsb.DimProductLineID = dpl.DimProductLineID
      JOIN DWH.core.DimSubsidiary               ds  WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
     


GROUP BY --de.DimEventID,
dpl.namelocal + ' - ' + de.nameLocal, dpl.typeLocal,f.starts_at,de.nameLocal
order by EventGGR 
),

b AS (
SELECT a.Event, a.Rank, a.EventGGR, a.League,
dms.alternateMarketLocal + ' - ' + dms.selectionLocal as MarketSelection,
f.starts_at as Date,
SUM (fsb.avgStake) AS Turnover,
SUM (fsb.wtStake) - SUM (fsb.wtEvaluatedProfit + fsb.wtEvaluatedTax) as GGR,
COUNT (DISTINCT fsb.ETLek) AS SlipCount,
ROW_NUMBER() OVER (PARTITION BY a.Event ORDER BY SUM (fsb.avgStake) - SUM (fsb.wtEvaluatedProfit + fsb.wtEvaluatedTax)  asc) AS MarketRank


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
	  JOIN bet.DimEvent de WITH (NOLOCK) ON fsb.DimEventID = de.DimEventID
      JOIN bet.SuperSport.sbk_offer.fixtures    f                 ON f.fid = 'f' + CAST(de.ETLek AS VARCHAR)
	  JOIN a on a.Match  = de.nameLocal and a.Date =f.starts_at
	  JOIN bet.DimMarketSelection dms with (nolock) on dms.DimMarketSelectionID = fsb.DimMarketSelectionID 
      JOIN core.DimProductLine dpl WITH (NOLOCK) ON fsb.DimProductLineID = dpl.DimProductLineID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID
     

WHERE DimDateID_Evaluated &gt;= @Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0

GROUP BY  dms.alternateMarketLocal + ' - ' + dms.selectionLocal, a.Event, a.EventGGR, a.Rank, a.League,f.starts_at

)

SELECT b.Event, b.League,
b.MarketSelection, 
b.Turnover, b.GGR, b.EventGGR, 
b.GGR/b.EventGGR As Perc,
case when b.Turnover = 0 then 0 else b.GGR/b.Turnover end as Margin,
b.SlipCount
FROM b
where MarketRank = 1
order by b.Rank desc</CommandText>
      </Query>
      <Fields>
        <Field Name="Event">
          <DataField>Event</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="League">
          <DataField>League</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MarketSelection">
          <DataField>MarketSelection</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="EventGGR">
          <DataField>EventGGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Perc">
          <DataField>Perc</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ClientRiskByGGR">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH 
c AS 
  (
  SELECT DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM bet.FactCustomerSegment fcs
  GROUP BY fcs.DimCustomerID
  ),
d AS (
  SELECT fcs.DimCustomerID, 
  r.riskFactor
  FROM bet.FactCustomerSegment fcs
  JOIN bet.DimRiskFactor r ON r.DimRiskFactorID = fcs.DimRiskFactorID_Prematch
  JOIN c ON c.DimCustomerID = fcs.DimCustomerID AND  c.Fresh = fcs.ETLts
  
  ),
a AS (
SELECT 
d.riskFactor as RiskFactor,
dc.nickname AS Nickname,
SUM (fs.stake) as Turnover,
SUM (fs.stake) - SUM (fs.evaluatedProfit+fs.evaluatedTax) as GGR,
SUM (fs.evaluatedProfit+fs.evaluatedTax) AS Winnings,
COUNT(fs.ETLek) AS SlipCount,
COUNT(DISTINCT fs.DimCustomerID) AS PlayerCount
FROM bet.FactSlip fs WITH (NOLOCK)
      left join d on d.DimCustomerID = fs.DimCustomerID
	  JOIN core.DimInterface di WITH (NOLOCK) ON di.DimInterfaceID = fs.DimInterfaceID
	   join core.DimCustomer DC WITH (NOLOCK) ON fs.DimCustomerID = DC.DimCustomerID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID
WHERE DimDateID_Evaluated &gt;= @Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND fs.DimCustomerID != 0
	   AND d.riskFactor &lt;= 1
 
GROUP BY  d.riskFactor,
			dc.nickname
),
e as (
SELECT *,
ROW_NUMBER() OVER (PARTITION BY a.RiskFactor ORDER BY a.GGR ) AS rn
FROM a
)
select *,  CASE WHEN e.Turnover = 0 THEN 0 ELSE (e.Turnover-e.Winnings)/e.Turnover END AS Margin
from e
where rn &lt;= 5
order by e.RiskFactor, e.GGR</CommandText>
      </Query>
      <Fields>
        <Field Name="RiskFactor">
          <DataField>RiskFactor</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Nickname">
          <DataField>Nickname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Winnings">
          <DataField>Winnings</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PlayerCount">
          <DataField>PlayerCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="rn">
          <DataField>rn</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TotalSlipsRF">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH 
c AS 
  (
  SELECT DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM bet.FactCustomerSegment fcs
  join bet.DimRiskFactor r on r.DimRiskFactorID = fcs.DimRiskFactorID_Live
  GROUP BY fcs.DimCustomerID

  ),
d AS (
  SELECT fcs.DimCustomerID, 
  r.riskFactor
  FROM bet.FactCustomerSegment fcs
  JOIN bet.DimRiskFactor r ON r.DimRiskFactorID = fcs.DimRiskFactorID_Live
  JOIN c ON c.DimCustomerID = fcs.DimCustomerID AND  c.Fresh = fcs.ETLts
  
  )

SELECT 
COUNT(distinct fs.ETLek) AS SlipCount


FROM bet.FactSlip fs WITH (NOLOCK)
      left join d on d.DimCustomerID = fs.DimCustomerID
	  JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
	  JOIN core.DimProductLine dpl WITH (NOLOCK) ON fsb.DimProductLineID = dpl.DimProductLineID
	  JOIN core.DimInterface di WITH (NOLOCK) ON di.DimInterfaceID = fs.DimInterfaceID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND fs.DimCustomerID != 0
	   AND d.riskFactor &lt;= 1</CommandText>
      </Query>
      <Fields>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
