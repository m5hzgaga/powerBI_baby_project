  <DataSources>
    <DataSource Name="DWH">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=1-bugatti.supersport.local;Initial Catalog=DWH</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
