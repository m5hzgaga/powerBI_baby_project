    <DataSet Name="Ticket">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH a AS (
SELECT 
CASE 
    WHEN fs.countBets &gt;= 10 THEN '10+' 
    ELSE CAST(fs.countBets AS VARCHAR) 
END AS countBets,
SUM (fs.stake) AS Turnover,
SUM (fs.evaluatedProfit + fs.evaluatedTax) as Winnings,
COUNT(DISTINCT fs.ETLek) AS SlipCount

FROM bet.FactSlip fs WITH (NOLOCK)
     JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID


WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
       AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0

GROUP BY CASE 
    WHEN fs.countBets &gt;= 10 THEN '10+' 
    ELSE CAST(fs.countBets AS VARCHAR) 
END 
)

SELECT  a.countBets BetCount, a.Turnover, a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/(a.Turnover) AS Margin, a.SlipCount
FROM a</CommandText>
      </Query>
      <Fields>
        <Field Name="BetCount">
          <DataField>BetCount</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TicketLive">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH a AS (
SELECT fsb.ETLek, 
CASE 
    WHEN SUM(CASE WHEN fsb.DimProductTypeID = 1 THEN 1 ELSE 0 END) = 0 THEN 'Live'
    WHEN SUM(CASE WHEN fsb.DimProductTypeID = 2 THEN 1 ELSE 0 END) = 0 THEN 'Prematch'
    ELSE 'Mix'
END AS ProductType,
COUNT (fsb.FactSlipBetID) AS BetCount


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0


GROUP BY fsb.ETLek
)
,
b AS (
SELECT 
 
CASE 
    WHEN a.BetCount &gt;= 10 THEN '10+' 
    ELSE CAST(a.BetCount AS VARCHAR) 
END AS BetCount,
SUM (CASE WHEN fs.isEvaluated = 1 THEN fsb.avgStake ELSE 0 END) AS Turnover,
COUNT(DISTINCT fsb.ETLek) AS SlipCount,
SUM (CASE WHEN fs.isEvaluated = 1 THEN fsb.avgEvaluatedProfit+fsb.avgEvaluatedTax ELSE 0 END) as Winnings


FROM a
JOIN bet.FactSlipBet fsb ON fsb.ETLek = a.ETLek
JOIN bet.FactSlip fs ON fs.ETLek = fsb.ETLek

WHERE a.ProductType = 'Live'
GROUP BY CASE 
    WHEN a.BetCount &gt;= 10 THEN '10+' 
    ELSE CAST(a.BetCount AS VARCHAR) 
END

)

SELECT b.BetCount, b.Turnover, b.Turnover-b.Winnings as GGR, ( b.Turnover-b.Winnings)/(b.Turnover) as Margin, b.SlipCount
FROM b</CommandText>
      </Query>
      <Fields>
        <Field Name="BetCount">
          <DataField>BetCount</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TicketMix">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH a AS (
SELECT fsb.ETLek, 
CASE 
    WHEN SUM(CASE WHEN fsb.DimProductTypeID = 1 THEN 1 ELSE 0 END) = 0 THEN 'Live'
    WHEN SUM(CASE WHEN fsb.DimProductTypeID = 2 THEN 1 ELSE 0 END) = 0 THEN 'Prematch'
    ELSE 'Mix'
END AS ProductType,
COUNT (fsb.FactSlipBetID) AS BetCount


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.countBets &gt; 1
	   AND fs.containsLive = 0



GROUP BY fsb.ETLek
)
,
b AS (
SELECT 
 
CASE 
    WHEN a.BetCount &gt;= 10 THEN '10+' 
    ELSE CAST(a.BetCount AS VARCHAR) 
END AS BetCount,
SUM (CASE WHEN fs.isEvaluated = 1 THEN fsb.avgStake ELSE 0 END) AS Turnover,
COUNT(DISTINCT fsb.ETLek) AS SlipCount,
SUM (CASE WHEN fs.isEvaluated = 1 THEN fsb.avgEvaluatedProfit+fsb.avgEvaluatedTax ELSE 0 END) as Winnings
FROM a
JOIN bet.FactSlipBet fsb ON fsb.ETLek = a.ETLek
JOIN bet.FactSlip fs ON fs.ETLek = fsb.ETLek

WHERE a.ProductType = 'Mix'
GROUP BY CASE 
    WHEN a.BetCount &gt;= 10 THEN '10+' 
    ELSE CAST(a.BetCount AS VARCHAR) 
END
)


SELECT b.BetCount, b.Turnover, b.Turnover-b.Winnings as GGR, ( b.Turnover-b.Winnings)/(b.Turnover) as Margin, b.SlipCount
FROM b</CommandText>
      </Query>
      <Fields>
        <Field Name="BetCount">
          <DataField>BetCount</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ClientRF">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);



WITH 
c AS 
  (
  SELECT DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM bet.FactCustomerSegment fcs
  GROUP BY fcs.DimCustomerID

  ),
d AS (
  SELECT fcs.DimCustomerID, r.riskFactor
  FROM bet.FactCustomerSegment fcs
  JOIN bet.DimRiskFactor r ON r.DimRiskFactorID = fcs.DimRiskFactorID_Prematch
  JOIN c ON c.DimCustomerID = fcs.DimCustomerID AND  c.Fresh = fcs.ETLts
  
  )

, a AS (
SELECT  ISNULL(CAST(d.riskFactor AS varchar(50)), 'Unassigned') as riskFactor,
SUM (fs.stake) AS Turnover,
SUM (fs.evaluatedProfit+fs.evaluatedTax) AS Winnings,
COUNT(fs.ETLek) AS SlipCount,
COUNT (DISTINCT fs.DimCustomerID) AS PlayerCount

FROM bet.FactSlip fs WITH (NOLOCK)
      left join d on d.DimCustomerID = fs.DimCustomerID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND fs.DimCustomerID != 0
 
GROUP BY d.riskFactor
)

SELECT a.riskFactor,a.Turnover, a.SlipCount, a.PlayerCount, a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/a.Turnover AS Margin
FROM a
ORDER BY a.riskFactor</CommandText>
      </Query>
      <Fields>
        <Field Name="riskFactor">
          <DataField>riskFactor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PlayerCount">
          <DataField>PlayerCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ClientsByStake">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);


WITH a AS (
SELECT  dc.nickname AS Nickname, fs.DimCustomerID,
SUM (fs.stake) as Turnover,
SUM (fs.evaluatedProfit+fs.evaluatedTax) as Winnings,
COUNT(fs.ETLek) AS SlipCount



FROM bet.FactSlip fs WITH (NOLOCK)
      join core.DimCustomer DC WITH (NOLOCK) ON fs.DimCustomerID = DC.DimCustomerID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	   AND fs.DimCustomerID != 0
 
GROUP BY  dc.nickname, fs.DimCustomerID
)
,
c AS 
  (
  SELECT DimCustomerID, MAX(fcs.ETLts) AS Fresh
  FROM bet.FactCustomerSegment fcs
  GROUP BY fcs.DimCustomerID
  ),
d AS (
  SELECT fcs.DimCustomerID,  rs.ETLek
  FROM bet.FactCustomerSegment fcs
  JOIN bet.DimRiskFactor rs ON rs.DimRiskFactorID = fcs.DimRiskFactorID_Prematch
  JOIN c ON c.DimCustomerID = fcs.DimCustomerID AND  c.Fresh = fcs.ETLts
  )


SELECT top (10) a.Nickname, ISNULL(CAST(d.ETLek AS varchar(50)), 'Unassigned') as ETLek,
a.Turnover, a.SlipCount, a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/a.Turnover AS Margin
FROM a 
left join d on a.DimCustomerID = d.DimCustomerID
where a.nickname is not null
order by Turnover desc</CommandText>
      </Query>
      <Fields>
        <Field Name="Nickname">
          <DataField>Nickname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ETLek">
          <DataField>ETLek</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
