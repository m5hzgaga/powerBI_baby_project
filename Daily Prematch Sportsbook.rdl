                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Turnover.Value</Value>
                                  <Style>
                                    <FontFamily>Arial Narrow</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Format>#,0.00</Format>
                                    <Color>=IIf(Fields!Turnover.Value&lt;0,"Red","Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
