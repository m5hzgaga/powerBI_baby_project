                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Turnover.Value / Sum(Fields!Turnover.Value, "ClientRiskByGGR")</Value>
                                  <Style>
                                    <FontFamily>Arial Narrow</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Format>0.00%</Format>
