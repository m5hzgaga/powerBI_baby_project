  <DataSets>
    <DataSet Name="ByProduct">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH a AS (
SELECT fsb.ETLek, 
CASE 
    WHEN SUM(CASE WHEN fsb.DimProductTypeID = 1 THEN 1 ELSE 0 END) = 0 THEN 'Live'
    WHEN SUM(CASE WHEN fsb.DimProductTypeID = 2 THEN 1 ELSE 0 END) = 0 THEN 'Prematch'
    ELSE 'Mix'
END AS ProductType

FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1 
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	  

GROUP BY fsb.ETLek
)
, 

b AS (
SELECT a.ProductType, 
COUNT(DISTINCT a.ETLek) AS SlipCount,
AVG (fs.stake) AS AvgStake,
SUM (fs.stake) AS Turnover,
SUM (fs.evaluatedProfit+fs.evaluatedTax) AS Winnings
FROM a
JOIN bet.FactSlip fs on a.ETLek = fs.ETLek
GROUP BY a.ProductType
)


SELECT b.ProductType, b.Turnover, b.SlipCount, b.Turnover-b.Winnings AS GGR, (b.Turnover-b.Winnings)/b.Turnover AS Margin, b.AvgStake
FROM b</CommandText>
      </Query>
      <Fields>
        <Field Name="ProductType">
          <DataField>ProductType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="AvgStake">
          <DataField>AvgStake</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ByChannel">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);



WITH a AS (
SELECT 
di.ETLek,
COUNT(fs.ETLek) AS SlipCount,
COUNT(DISTINCT fs.DimCustomerID) AS PlayerCount,
SUM (fs.stake) AS Turnover,
SUM (fs.evaluatedProfit + fs.evaluatedTax) as Winnings


FROM bet.FactSlip fs WITH (NOLOCK)
	  JOIN core.DimInterface di WITH (NOLOCK) ON di.DimInterfaceID = fs.DimInterfaceID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID

WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0
	 
GROUP BY di.ETLek
)

SELECT a.ETLek AS Interface, a.Turnover, a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/(a.Turnover) AS Margin, a.SlipCount, a.PlayerCount
FROM a</CommandText>
      </Query>
      <Fields>
        <Field Name="Interface">
          <DataField>Interface</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PlayerCount">
          <DataField>PlayerCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SportsByStake">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH a AS (
SELECT 
dpl.nameLocal AS Sport,
SUM (fsb.avgStake) AS Turnover,
SUM (fsb.wtEvaluatedProfit + fsb.wtEvaluatedTax) as Winnings,
COUNT(DISTINCT fsb.ETLek) AS SlipCount


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
      JOIN core.DimProductLine dpl WITH (NOLOCK) ON fsb.DimProductLineID = dpl.DimProductLineID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID


WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0

GROUP BY dpl.nameLocal
)

SELECT TOP (10) A.Sport AS Sport, a.Turnover, a.Turnover-A.Winnings as GGR, (a.Turnover-A.Winnings)/(a.Turnover) AS Margin, a.SlipCount
FROM a 
ORDER BY Turnover DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="Sport">
          <DataField>Sport</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LeagueByStake">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH a AS (
SELECT 
dpl.namelocal + ' - ' + dpl.typeLocal AS League,
SUM (fsb.avgStake) AS Turnover,
SUM (fsb.wtEvaluatedProfit + fsb.wtEvaluatedTax) as Winnings,
COUNT(DISTINCT fsb.ETLek) AS SlipCount

FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
      JOIN core.DimProductLine dpl WITH (NOLOCK) ON fsb.DimProductLineID = dpl.DimProductLineID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID


WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
       AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0

GROUP BY dpl.namelocal + ' - ' + dpl.typeLocal
)

SELECT TOP (10) A.League AS League, a.Turnover, a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/(a.Turnover) AS Margin, a.SlipCount
FROM a 
ORDER BY Turnover DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="League">
          <DataField>League</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MatchesByStake">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH a AS (
SELECT 
dpl.nameLocal AS Sport,
dpl.typeLocal AS League,
de.nameLocal AS Event,
f.starts_at as Date,
SUM (fsb.avgStake) AS Turnover,
SUM (fsb.wtEvaluatedProfit + fsb.wtEvaluatedTax) as Winnings,
COUNT(DISTINCT fsb.ETLek) AS SlipCount


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
	  JOIN bet.DimEvent de WITH (NOLOCK) ON fsb.DimEventID = de.DimEventID
	  JOIN bet.SuperSport.sbk_offer.fixtures f on f.fid = 'f' + CAST(de.ETLek AS VARCHAR)
      JOIN core.DimProductLine dpl WITH (NOLOCK) ON fsb.DimProductLineID = dpl.DimProductLineID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID
	  JOIN core.DimDate dd  WITH (NOLOCK) ON dd.DimDateID = de.DimDateID


WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0

GROUP BY de.nameLocal, dpl.nameLocal, f.starts_at, dpl.typeLocal
)
SELECT TOP (10) a.Sport, a.Date, a.League,
A.Event AS Event, a.Turnover, a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/(a.Turnover) AS Margin, a.SlipCount
FROM a 
ORDER BY Turnover desc</CommandText>
      </Query>
      <Fields>
        <Field Name="Sport">
          <DataField>Sport</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date">
          <DataField>Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="League">
          <DataField>League</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Event">
          <DataField>Event</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Turnover">
          <DataField>Turnover</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GGR">
          <DataField>GGR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Margin">
          <DataField>Margin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SlipCount">
          <DataField>SlipCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MatchesByGGR">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Start INT; 
SET @Start = year(@StartDate) * 10000 + MONTH(@StartDate) * 100 + DATEPART(DAY, @StartDate);
DECLARE @End INT;
SET @End = year(@EndDate) * 10000 + MONTH(@EndDate) * 100 + DATEPART(DAY, @EndDate);

WITH a AS (
SELECT 
dpl.nameLocal AS Sport,
dpl.typeLocal as League,
de.nameLocal AS Event,
f.starts_at as Date,
SUM (fsb.avgStake) AS Turnover,
SUM (fsb.wtEvaluatedProfit + fsb.wtEvaluatedTax) as Winnings,
COUNT(DISTINCT fsb.ETLek) AS SlipCount


FROM bet.FactSlip fs WITH (NOLOCK)
      JOIN bet.FactSlipBet fsb WITH (NOLOCK)ON fs.ETLek = fsb.ETLek
	  JOIN bet.DimEvent de WITH (NOLOCK) ON fsb.DimEventID = de.DimEventID
	  JOIN bet.SuperSport.sbk_offer.fixtures f on f.fid = 'f' + CAST(de.ETLek AS VARCHAR)
      JOIN core.DimProductLine dpl WITH (NOLOCK) ON fsb.DimProductLineID = dpl.DimProductLineID
      JOIN DWH.core.DimSubsidiary ds WITH (NOLOCK) ON fs.DimSubsidiaryID = ds.DimSubsidiaryID
	  JOIN core.DimDate dd  WITH (NOLOCK) ON dd.DimDateID = de.DimDateID


WHERE DimDateID_Evaluated &gt;=@Start AND DimDateID_Evaluated &lt;= @End
 	   AND fs.isEvaluated = 1
       AND fs.DimProductFamilyID = 1 
       AND fs.DimProductClassID = 5 
       AND fs.isAuthRejected = 0
       AND fs.isAccepted = 1
	   AND fs.isCanceled = 0
       AND ds.ETLek &gt; 0
	   AND fs.containsLive = 0

GROUP BY de.nameLocal, dpl.nameLocal, f.starts_at, dpl.typeLocal
)

SELECT TOP (10) a.Sport, a.Date, a.League,
A.Event AS Event, a.Turnover, a.Turnover-a.Winnings as GGR, (a.Turnover-a.Winnings)/(a.Turnover) AS Margin, a.SlipCount
FROM a 
ORDER BY GGR desc</CommandText>
      </Query>
      <Fields>
        <Field Name="Sport">
          <DataField>Sport</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Event">
          <DataField>Event</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date">
